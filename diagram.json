    [ "pir:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "pir:OUT", "esp:27", "green", [ "v0" ] ],
    [ "pir:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ldr:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr:AO", "esp:34", "green", [ "v0" ] ],
    [ "ldr:GND", "esp:GND.1", "black", [ "v0" ] ],
